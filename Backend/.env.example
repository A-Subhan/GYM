# SQL Server connection (GymDB)
# Replace with your actual connection string. Never commit real credentials.
DATABASE_URL="sqlserver://localhost:1433;database=GymDB;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true;encrypt=true"

# Auth secret for session tokens — use a strong random value (32+ chars)
JWT_SECRET="generate-a-strong-random-secret-here"

# Initial admin password for seeding (min 8 characters)
ADMIN_PASSWORD="set-a-secure-password-here"
