  staffId    String @db.NVarChar(50)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documentType String @db.NVarChar(255) // CNIC, Contract, Certificate, Photo, Other
  documentName String @db.NVarChar(255)
  fileUrl    String @db.NVarChar(255)
  issueDate  DateTime?
  expiryDate DateTime?
  status     String @db.NVarChar(255)   @default("Active")
  notes      String? @db.NVarChar(MAX)
  uploadedBy String? @db.NVarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([staffId])
}

model FoodItem {
  id         String @db.NVarChar(50)   @id @default(cuid())
  code       String @db.NVarChar(255)
  name       String @db.NVarChar(255)
  category   String? @db.NVarChar(255)
  calories   Float    @default(0)
  protein    Float    @default(0)
  carbs      Float    @default(0)
  fat        Float    @default(0)
  servingSize String? @db.NVarChar(255)
  unit       String? @db.NVarChar(255)
  status     String @db.NVarChar(255)   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([code])
}

// =================================================================
// INVENTORY EXTENSION
// =================================================================

model Supplier {
  id         String @db.NVarChar(50)   @id @default(cuid())
  code       String @db.NVarChar(255)
  name       String @db.NVarChar(255)
  contactPerson String? @db.NVarChar(255)
  phone      String? @db.NVarChar(255)
  email      String? @db.NVarChar(255)
  address    String? @db.NVarChar(MAX)
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation("SupplierBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status     String @db.NVarChar(255)   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases  Purchase[]
}

model Purchase {
  id         String @db.NVarChar(50)   @id @default(cuid())
  purchaseNo  String @db.NVarChar(191)  @unique
  supplierId String? @db.NVarChar(50)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId   String @db.NVarChar(50)
  branch     Branch   @relation("PurchaseBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseDate DateTime @default(now())
  totalAmount Float   @default(0)
  status     String @db.NVarChar(255)   @default("Pending") // Pending, Received, Cancelled
  notes      String? @db.NVarChar(MAX)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines      PurchaseLine[]
}

model PurchaseLine {
  id         String @db.NVarChar(50)   @id @default(cuid())
  purchaseId String @db.NVarChar(50)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryItemId String? @db.NVarChar(50)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemName   String @db.NVarChar(255)
  quantity   Int      @default(0)
  unitPrice  Float    @default(0)
  amount     Float    @default(0)
}

model StockMovement {
  id         String @db.NVarChar(50)   @id @default(cuid())
  inventoryItemId String @db.NVarChar(50)
  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId   String @db.NVarChar(50)
  branch     Branch   @relation("StockMoveBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movementType String @db.NVarChar(255) // PurchaseIn, PurchaseReturn, StockIn, StockOut, Adjustment, Transfer
  quantity   Int
  reference  String? @db.NVarChar(255)
  referenceId String? @db.NVarChar(50)
  date       DateTime @default(now())
  notes      String? @db.NVarChar(MAX)
  createdAt  DateTime @default(now())

  @@index([inventoryItemId])
  @@index([branchId, date])
}
