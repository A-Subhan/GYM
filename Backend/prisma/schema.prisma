// Contoura Gym Management System — full ERP schema
// Reconciled with the FINAL GymDB schema after Database/migrations/00..12
// (see final_schema_contract.md). Table names are mapped via @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =================================================================
// CORE
// =================================================================

model Branch {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  code      String   @unique @db.NVarChar(191)
  name      String   @db.NVarChar(255)
  parentId  String?  @db.NVarChar(50)
  parent    Branch?  @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Branch[] @relation("BranchHierarchy")
  nodeType  String   @default("Detail") // Control | Detail (hierarchical Branch File)
  address   String?  @db.NVarChar(MAX)
  city      String?  @db.NVarChar(255)
  phone     String?  @db.NVarChar(255)
  email     String?  @db.NVarChar(255)
  strn      String?  @db.NVarChar(255)
  ntn       String?  @db.NVarChar(255)
  trn       String?  @db.NVarChar(255)
  fbr       String?  @db.NVarChar(255)
  logo      String?  @db.NVarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  users                 User[]
  charts                Chart[]
  members               Member[]
  membershipPlans       MembershipPlan[]
  attendance            Attendance[]
  fees                  Fee[]
  equipment             Equipment[]
  inventory             InventoryItem[]
  prospects             Prospect[]
  workoutPlans          WorkoutPlan[]
  dietPlans             DietPlan[]
  staff                 Staff[]
  shifts                Shift[]
  calendar              CalendarDay[]
  taxHeads              TaxHead[]
  payroll               Payroll[]
  posSales              PosSale[]
  followUps             FollowUp[]
  freezes               MembershipFreeze[]
  progressEntries       ProgressEntry[]           @relation("ProgressEntryBranch")
  leaves                Leave[]                   @relation("LeaveBranch")
  // New relations from extended models
  trainerAvailabilities TrainerAvailability[]     @relation("TrainerAvailBranch")
  trainerSchedules      TrainerSchedule[]         @relation("TrainerSchedBranch")
  ptSessions            PersonalTrainingSession[] @relation("PTSessionBranch")
  suppliers             Supplier[]                @relation("SupplierBranch")
  purchases             Purchase[]                @relation("PurchaseBranch")
  stockMovements        StockMovement[]           @relation("StockMoveBranch")
  cashBookVouchers      CashBook[]                @relation("CashBookBranch")
  bankBookVouchers      BankBook[]                @relation("BankBookBranch")
  journalVouchers       JournalVoucher[]          @relation("JournalBranch")
  openingTbVouchers     OpeningTbVoucher[]        @relation("OpenTbBranch")
  knockOffs             KnockOff[]
  masterFiles           MasterFile[]              @relation("MasterFileBranch")
  payrollMasterFiles    PayrollMasterFile[]       @relation("PayrollMasterFileBranch")
  gymMasterFiles        GymMasterFile[]
  gymMasters            GymMaster[]               @relation("GymMasterBranch")
  gymMasterDetails      GymMasterDetail[]         @relation("GymMasterDetailBranch")
  financeMasters        FinanceMaster[]           @relation("FinanceMasterBranch")
  financeMasterDetails  FinanceMasterDetail[]     @relation("FinanceMasterDetailBranch")
  payrollMasters        PayrollMaster[]           @relation("PayrollMasterBranch")
  payrollMasterDetails  PayrollMasterDetail[]     @relation("PayrollMasterDetailBranch")
}

model Role {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  name        String   @unique @db.NVarChar(191)
  description String?  @db.NVarChar(MAX)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  permissions       RolePermission[]
  screenPermissions ScreenPermission[]
}

// Per-screen permissions: 52 screens x View/Add/Edit/Delete/Print, applied at session level
model ScreenPermission {
  id        String  @id @default(cuid()) @db.NVarChar(50)
  roleId    String  @db.NVarChar(50)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  screenKey String  @db.NVarChar(255)
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canPrint  Boolean @default(false)

  @@unique([roleId, screenKey])
  @@index([screenKey])
}

// Per-USER per-screen permission overrides (Admin Defaults → Security)
model UserPermission {
  id        String  @id @default(cuid()) @db.NVarChar(50)
  userId    String  @db.NVarChar(50)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  screenKey String  @db.NVarChar(255)
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canPrint  Boolean @default(false)

  @@unique([userId, screenKey])
  @@index([screenKey])
}

model Permission {
  id          String  @id @default(cuid()) @db.NVarChar(50)
  module      String  @db.NVarChar(255)
  action      String  @db.NVarChar(255)
  code        String  @unique @db.NVarChar(191)
  description String? @db.NVarChar(MAX)

  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.NVarChar(50)
  permissionId String     @db.NVarChar(50)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model User {
  id                  String    @id @default(cuid()) @db.NVarChar(50)
  username            String    @unique @db.NVarChar(191)
  email               String?   @unique @db.NVarChar(191)
  fullName            String    @db.NVarChar(255)
  passwordHash        String    @db.NVarChar(255)
  // "User Type" security model: Admin = full rights automatically;
  // User = per-screen permissions (dbo.UserPermission). Legacy role kept
  // only for backward compatibility with pre-existing data.
  userType            String    @default("User") @db.NVarChar(255) // Admin | User
  roleId              String?   @db.NVarChar(50)
  role                Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId            String?   @db.NVarChar(50)
  branch              Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accessibleBranchIds String    @default("*") @db.NVarChar(255)
  phone               String?   @db.NVarChar(255)
  photo               String?   @db.NVarChar(255)
  isActive            Boolean   @default(true)
  failedLoginCount    Int       @default(0)
  lastLoginAt         DateTime?
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  isDeleted           Boolean   @default(false)

  sessions        Session[]
  auditLogs       AuditLog[]
  userPermissions UserPermission[]
}

model Session {
  id           String   @id @default(cuid()) @db.NVarChar(50)
  userId       String   @db.NVarChar(50)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshToken String   @db.NVarChar(255)
  ipAddress    String?  @db.NVarChar(255)
  userAgent    String?  @db.NVarChar(255)
  location     String?  @db.NVarChar(255)
  status       String   @default("Active") @db.NVarChar(255)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model AuditLog {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  userId    String?  @db.NVarChar(50)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String   @db.NVarChar(255)
  module    String   @db.NVarChar(255)
  details   String?  @db.NVarChar(MAX)
  ipAddress String?  @db.NVarChar(255)
  location  String?  @db.NVarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// =================================================================
// FINANCE
// =================================================================

// Chart of Accounts — table "charts"; id IS the account code (e.g. 01, 1000-001).
// Hierarchy uses a single NOT NULL parentCode column; tree roots use the
// sentinel value 'ROOT'. Opening balances live in OpenTB vouchers.
model Chart {
  id                 String   @id @db.NVarChar(50) // id = account code
  name               String   @db.NVarChar(255)
  parentCode         String   @db.NVarChar(50) // 'ROOT' for tree roots
  parent             Chart?   @relation("ChartHierarchy", fields: [parentCode], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           Chart[]  @relation("ChartHierarchy")
  accountType        String   @db.NVarChar(255)
  bookType           String?  @db.NVarChar(255)
  accountTag         String?  @db.NVarChar(255)
  isControl          Boolean  @default(false)
  isDetail           Boolean  @default(true)
  isActive           Boolean  @default(true)
  branchId           String?  @db.NVarChar(50)
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactName        String?  @db.NVarChar(255)
  phone              String?  @db.NVarChar(255)
  email              String?  @db.NVarChar(255)
  address            String?  @db.NVarChar(MAX)
  bankName           String?  @db.NVarChar(255)
  bankAccountNo      String?  @db.NVarChar(255)
  bankBranch         String?  @db.NVarChar(255)
  cnic               String?  @db.NVarChar(255)
  strn               String?  @db.NVarChar(255)
  ntn                String?  @db.NVarChar(255)
  fbr                String?  @db.NVarChar(255)
  otherName          String?  @db.NVarChar(255)
  referenceNumber    String?  @db.NVarChar(255)
  faxNumber          String?  @db.NVarChar(255)
  city               String?  @db.NVarChar(255)
  country            String?  @db.NVarChar(255)
  website            String?  @db.NVarChar(255)
  paymentTerms       String?  @db.NVarChar(255)
  registrationNumber String?  @db.NVarChar(255)
  description        String?  @db.NVarChar(MAX)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cashBookLines       CashBookLine[]       @relation("CashBookLines")
  bankBookLines       BankBookLine[]       @relation("BankBookLines")
  journalVoucherLines JournalVoucherLine[] @relation("JournalVoucherLines")
  openingTbLines      OpeningTbLine[]      @relation("OpeningTbLines")
  cashBookVouchers    CashBook[]           @relation("CashBookBookAccount")
  bankBookVouchers    BankBook[]           @relation("BankBookBookAccount")
  knockOffs           KnockOff[]
  mappings            AccountMapping[]

  @@index([parentCode])
  @@index([branchId])
  @@index([accountType])
  @@map("charts")
}

// =================================================================
// DEDICATED BOOK VOUCHERS (four books, each with its own line table)
// id = voucher number, format {TYPE}/{branchCode}/{MMMyy UPPER}/{000001}
// CashBook: CRV (Cash Receipt) + CPV (Cash Payment)
// BankBook: BRV (Bank Receipt) + BPV (Bank Payment)
// JournalVoucher (@@map "JV"): JV
// OpeningTbVoucher (@@map "OpenTB"): OTV — unbalanced save allowed
// Reversals append -R to the id.
// =================================================================

model CashBook {
  id             String    @id @db.NVarChar(50) // voucher number, e.g. CRV/BR-001/SEP26/000001
  voucherType    String    @db.NVarChar(10) // CRV | CPV
  voucherDate    DateTime
  branchId       String    @db.NVarChar(50)
  branch         Branch    @relation("CashBookBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookChartId    String    @db.NVarChar(50) // cash book account (charts.id)
  bookChart      Chart     @relation("CashBookBookAccount", fields: [bookChartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description    String?   @db.NVarChar(MAX)
  reference      String?   @db.NVarChar(255)
  paymentMode    String?   @db.NVarChar(255) // Cash | Cheque
  totalAmount    Float     @default(0)
  status         String    @default("Posted") @db.NVarChar(255) // Posted | Reversed
  // SOFT delete — deleted vouchers stay in the DB but are excluded from
  // lists, reports and ledgers (lines remain for the audit trail).
  isDeleted      Boolean   @default(false)
  deletedById    String?   @db.NVarChar(50)
  deletedAt      DateTime?
  reversedById   String?   @db.NVarChar(50)
  reversedAt     DateTime?
  reversalReason String?   @db.NVarChar(255)
  postedById     String?   @db.NVarChar(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines CashBookLine[]

  @@index([voucherType])
  @@index([voucherDate])
  @@index([branchId])
  @@map("CashBook")
}

model CashBookLine {
  id              String   @id @db.NVarChar(50) // business id: C/{year}/{000001} (app-generated)
  voucherId       String   @db.NVarChar(50)
  voucher         CashBook @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId       String   @db.NVarChar(50)
  account         Chart    @relation("CashBookLines", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit           Float    @default(0)
  credit          Float    @default(0)
  amount          Float    @default(0)
  taxPercent      Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0) // amount + taxAmount
  lineDescription String?  @db.NVarChar(255)
  title           String?  @db.NVarChar(255)
  reference       String?  @db.NVarChar(255)
  billType        String?  @db.NVarChar(255) // Sales Bill, Purchase Bill, ... (Dr/Cr side auto-applied)
  chequeNo        String?  @db.NVarChar(255)
  chequeAmount    Float?
  chequeBankName  String?  @db.NVarChar(255)
  chequeStatus    String?  @db.NVarChar(255)
  status          String   @default("Active") @db.NVarChar(255)
  createdAt       DateTime @default(now())

  @@index([voucherId])
  @@index([accountId])
  @@map("CashBookLine")
}

model BankBook {
  id             String    @id @db.NVarChar(50) // voucher number, e.g. BPV/BR-001/SEP26/000001
  voucherType    String    @db.NVarChar(10) // BRV | BPV
  voucherDate    DateTime
  branchId       String    @db.NVarChar(50)
  branch         Branch    @relation("BankBookBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookChartId    String    @db.NVarChar(50) // bank book account (charts.id)
  bookChart      Chart     @relation("BankBookBookAccount", fields: [bookChartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description    String?   @db.NVarChar(MAX)
  reference      String?   @db.NVarChar(255)
  paymentMode    String?   @db.NVarChar(255) // Cash | Cheque | Online Transfer
  totalAmount    Float     @default(0)
  status         String    @default("Posted") @db.NVarChar(255) // Posted | Reversed
  // SOFT delete — see CashBook
  isDeleted      Boolean   @default(false)
  deletedById    String?   @db.NVarChar(50)
  deletedAt      DateTime?
  reversedById   String?   @db.NVarChar(50)
  reversedAt     DateTime?
  reversalReason String?   @db.NVarChar(255)
  postedById     String?   @db.NVarChar(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines BankBookLine[]

  @@index([voucherType])
  @@index([voucherDate])
  @@index([branchId])
  @@map("BankBook")
}

model BankBookLine {
  id              String   @id @db.NVarChar(50) // business id: B/{year}/{000001} (app-generated)
  voucherId       String   @db.NVarChar(50)
  voucher         BankBook @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId       String   @db.NVarChar(50)
  account         Chart    @relation("BankBookLines", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit           Float    @default(0)
  credit          Float    @default(0)
  amount          Float    @default(0)
  taxPercent      Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0) // amount + taxAmount
  lineDescription String?  @db.NVarChar(255)
  title           String?  @db.NVarChar(255)
  reference       String?  @db.NVarChar(255)
  billType        String?  @db.NVarChar(255)
  // Bank voucher line: the APPLICATION keeps chequeAmount synced to amount.
  chequeNo        String?  @db.NVarChar(255)
  chequeAmount    Float?
  chequeBankName  String?  @db.NVarChar(255)
  chequeStatus    String?  @db.NVarChar(255)
  status          String   @default("Active") @db.NVarChar(255)
  createdAt       DateTime @default(now())

  @@index([voucherId])
  @@index([accountId])
  @@map("BankBookLine")
}

model JournalVoucher {
  id             String    @id @db.NVarChar(50) // voucher number, e.g. JV/BR-001/SEP26/000001
  voucherType    String    @default("JV") @db.NVarChar(10)
  voucherDate    DateTime
  branchId       String    @db.NVarChar(50)
  branch         Branch    @relation("JournalBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description    String?   @db.NVarChar(MAX)
  reference      String?   @db.NVarChar(255)
  totalDebit     Float     @default(0)
  totalCredit    Float     @default(0)
  status         String    @default("Posted") @db.NVarChar(255) // Posted | Reversed
  // SOFT delete — see CashBook
  isDeleted      Boolean   @default(false)
  deletedById    String?   @db.NVarChar(50)
  deletedAt      DateTime?
  reversedById   String?   @db.NVarChar(50)
  reversedAt     DateTime?
  reversalReason String?   @db.NVarChar(255)
  postedById     String?   @db.NVarChar(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines JournalVoucherLine[]

  @@index([voucherDate])
  @@index([branchId])
  @@map("JV")
}

model JournalVoucherLine {
  id              String         @id @db.NVarChar(50) // business id: J/{year}/{000001} (app-generated)
  voucherId       String         @db.NVarChar(50)
  voucher         JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId       String         @db.NVarChar(50)
  account         Chart          @relation("JournalVoucherLines", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit           Float          @default(0)
  credit          Float          @default(0)
  amount          Float          @default(0)
  taxPercent      Float          @default(0)
  taxAmount       Float          @default(0)
  total           Float          @default(0) // amount + taxAmount
  lineDescription String?        @db.NVarChar(255)
  reference       String?        @db.NVarChar(255)
  status          String         @default("Active") @db.NVarChar(255)
  createdAt       DateTime       @default(now())

  @@index([voucherId])
  @@index([accountId])
  @@map("JVLine")
}

model OpeningTbVoucher {
  id             String    @id @db.NVarChar(50) // voucher number, e.g. OTV/BR-001/SEP26/000001
  voucherType    String    @default("OTV") @db.NVarChar(10)
  voucherDate    DateTime
  branchId       String    @db.NVarChar(50)
  branch         Branch    @relation("OpenTbBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description    String?   @db.NVarChar(255)
  reference      String?   @db.NVarChar(255)
  totalDebit     Float     @default(0)
  totalCredit    Float     @default(0)
  difference     Float     @default(0) // totalDebit - totalCredit (allowed non-zero)
  isBalanced     Boolean   @default(false)
  status         String    @default("Posted") @db.NVarChar(255) // Posted | Reversed
  // SOFT delete — see CashBook
  isDeleted      Boolean   @default(false)
  deletedById    String?   @db.NVarChar(50)
  deletedAt      DateTime?
  reversedById   String?   @db.NVarChar(50)
  reversedAt     DateTime?
  reversalReason String?   @db.NVarChar(255)
  postedById     String?   @db.NVarChar(50)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lines OpeningTbLine[]
  // NOTE: intentionally NO balance constraint — an unbalanced opening TB
  // may be saved (knock-offs are handled in the KnockOff table).

  @@index([voucherDate])
  @@index([branchId])
  @@map("OpenTB")
}

model OpeningTbLine {
  id              String           @id @db.NVarChar(50) // business id: O/{year}/{000001} (app-generated)
  voucherId       String           @db.NVarChar(50)
  voucher         OpeningTbVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId       String           @db.NVarChar(50)
  account         Chart            @relation("OpeningTbLines", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit           Float            @default(0)
  credit          Float            @default(0)
  amount          Float            @default(0)
  lineDescription String?          @db.NVarChar(255)
  reference       String?          @db.NVarChar(255)
  status          String           @default("Active") @db.NVarChar(255)
  createdAt       DateTime         @default(now())

  @@index([voucherId])
  @@index([accountId])
  @@map("OpenTBLine")
}

// Bill-wise knock-offs (bill ID OTB-{branchCode}/{0000001}); the
// Customer/Supplier accountTag rule is enforced by the APPLICATION.
model KnockOff {
  id              String    @id @default(cuid()) @db.NVarChar(50)
  billId          String    @unique @db.NVarChar(50) // auto: OTB-{branchCode}/{0000001}
  billNumber      String?   @db.NVarChar(255)
  referenceNumber String?   @db.NVarChar(255)
  billType        String?   @db.NVarChar(255)
  amount          Float
  dcFlag          String    @default("Debit") @db.NVarChar(10) // Debit | Credit
  referenceDate   DateTime?
  dueDate         DateTime?
  description     String?   @db.NVarChar(20) // max 20 chars (app enforced)
  accountId       String    @db.NVarChar(50)
  account         Chart     @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String    @db.NVarChar(50)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById     String?   @db.NVarChar(50)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accountId])
  @@index([branchId])
}

// Atomic sequence counter for business ID generation (key like "CRV/BR-001/SEP26")
model IdSequence {
  key       String   @id @db.NVarChar(191)
  next      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("IdSequence")
}

// Admin Defaults — THE company/defaults table (replaces Company).
// companyName is WRITE-ONCE (trigger trg_Defaults_CompanyNameLock).
model Defaults {
  id             String   @id @default(cuid()) @db.NVarChar(50)
  companyName    String?  @db.NVarChar(255)
  address        String?  @db.NVarChar(MAX)
  phone          String?  @db.NVarChar(255)
  email          String?  @db.NVarChar(255)
  website        String?  @db.NVarChar(255)
  logo           String?  @db.NVarChar(255)
  strn           String?  @db.NVarChar(255)
  ntn            String?  @db.NVarChar(255)
  fbr            String?  @db.NVarChar(255)
  financeType    String   @default("FIFO") @db.NVarChar(255) // FIFO | BillWise
  coaLevelDigits String   @default("2") @db.NVarChar(100) // digits per COA level, e.g. '2'
  coaLocked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("Defaults")
}

model FinancialYear {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  name      String   @unique @db.NVarChar(191)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods AccountingPeriod[]
}

model AccountingPeriod {
  id              String        @id @default(cuid()) @db.NVarChar(50)
  financialYearId String        @db.NVarChar(50)
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name            String        @db.NVarChar(255)
  startDate       DateTime
  endDate         DateTime
  status          String        @default("Open") @db.NVarChar(255)
  createdAt       DateTime      @default(now())

  @@index([financialYearId])
}

model TaxHead {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  code      String   @db.NVarChar(255)
  shortName String   @db.NVarChar(255)
  name      String   @db.NVarChar(255)
  taxType   String   @db.NVarChar(255)
  rate      Float
  branchId  String?  @db.NVarChar(50)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model AccountMapping {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  branchId    String?  @db.NVarChar(50)
  key         String   @db.NVarChar(255)
  accountId   String   @db.NVarChar(50) // charts.id (account code)
  account     Chart    @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String?  @db.NVarChar(MAX)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, key])
  @@index([key])
}

model FinanceDefaults {
  id                   String   @id @default(cuid()) @db.NVarChar(50)
  branchId             String?  @unique @db.NVarChar(50)
  defaultCashAccountId String?  @db.NVarChar(50) // charts code
  defaultBankAccountId String?  @db.NVarChar(50) // charts code
  defaultTaxHeadId     String?  @db.NVarChar(50)
  financialYearId      String?  @db.NVarChar(50)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UserReportFormat {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  userId    String   @db.NVarChar(50)
  reportKey String   @db.NVarChar(255)
  name      String   @db.NVarChar(255)
  columns   String   @db.NVarChar(255)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportKey, name])
  @@index([userId, reportKey])
}

// =================================================================
// GYM
// =================================================================

// id IS the business id ({branch}/{MMMyy}/{00001}); no separate memberId.
model Member {
  id                 String          @id @db.NVarChar(50) // business id
  joiningFee         Float           @default(0) // one-time joining fee; first invoice = membership fee + joining fee
  firstName          String          @db.NVarChar(255)
  lastName           String?         @db.NVarChar(255)
  gender             String?         @db.NVarChar(255)
  dob                DateTime?
  phone              String?         @db.NVarChar(255)
  whatsapp           String?         @db.NVarChar(255)
  email              String?         @db.NVarChar(255)
  address            String?         @db.NVarChar(MAX)
  emergencyContact   String?         @db.NVarChar(255)
  emergencyContactNo String?         @db.NVarChar(255)
  photo              String?         @db.NVarChar(255)
  cnic               String?         @db.NVarChar(255)
  joiningDate        DateTime        @default(now())
  billingStartDate   DateTime?
  feeRelaxationDays  Int             @default(0)
  status             String          @default("Active") @db.NVarChar(255)
  membershipPlanId   String?         @db.NVarChar(50)
  membershipPlan     MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId           String          @db.NVarChar(50)
  branch             Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTrainerId  String?         @db.NVarChar(50)
  notes              String?         @db.NVarChar(MAX)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  isDeleted          Boolean         @default(false)
  deletedAt          DateTime?

  attendance         Attendance[]
  fees               Fee[]
  progress           ProgressEntry[]
  freezes            MembershipFreeze[]
  followUps          FollowUp[]
  workoutAssignments WorkoutAssignment[]
  dietAssignments    DietAssignment[]
  fitnessGoals       FitnessGoal[]
  ptSessions         PersonalTrainingSession[]

  @@index([branchId])
  @@index([status])
  @@index([phone])
}

// id IS the business id ({branch}/{MMMyy}/{00001}); no separate code.
model MembershipPlan {
  id           String   @id @db.NVarChar(50) // business id
  name         String   @db.NVarChar(255)
  durationDays Int
  amount       Float
  description  String?  @db.NVarChar(MAX)
  branchId     String   @db.NVarChar(50)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members Member[]

  @@index([branchId])
}

model Attendance {
  id        String    @id @db.NVarChar(50) // business id {branch}/{MMMyy}/{00001}
  memberId  String    @db.NVarChar(50)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId  String    @db.NVarChar(50)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  checkIn   DateTime?
  checkOut  DateTime?
  notes     String?   @db.NVarChar(MAX)
  createdAt DateTime  @default(now())

  @@unique([memberId, date])
  @@index([branchId, date])
}

// id IS the business fee number {branch}/{MMMyy}/{00001}; no separate feeNo.
model Fee {
  id                 String    @id @db.NVarChar(50) // business id
  memberId           String    @db.NVarChar(50)
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId           String    @db.NVarChar(50)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  amount             Float
  discount           Float     @default(0)
  paidAmount         Float     @default(0)
  balance            Float     @default(0)
  dueDate            DateTime
  status             String    @default("Unpaid") @db.NVarChar(255)
  paymentMethod      String?   @db.NVarChar(255)
  paymentAccountId   String?   @db.NVarChar(50)
  paymentDate        DateTime?
  reference          String?   @db.NVarChar(255)
  bookVoucherId      String?   @db.NVarChar(50) // CRV/CPV/BRV/BPV voucher number posted on payment
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments FeePayment[]

  @@index([memberId])
  @@index([branchId])
  @@index([status])
  @@index([dueDate])
}

model FeePayment {
  id             String   @id @db.NVarChar(50) // business id FP/{branchCode}/{MMMyy}/{000001} (set by the API, not cuid)
  feeId          String   @db.NVarChar(50)
  fee            Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookVoucherId  String   @db.NVarChar(50) // CRV (cash) or BRV (bank) voucher number
  amount         Float
  method         String   @db.NVarChar(255) // Cash | Card | Bank Transfer | Online
  accountId      String   @db.NVarChar(50)
  cardTypeId     String?  @db.NVarChar(50) // MasterFile id (masterType = 'CardTypes') when method = Card
  cardTypeName   String?  @db.NVarChar(255) // snapshot of card type name at time of payment
  bankMasterId   String?  @db.NVarChar(50) // MasterFile id (masterType = 'Banks') when method = Bank Transfer
  bankMasterName String?  @db.NVarChar(255) // snapshot of bank name at time of payment
  createdAt      DateTime @default(now())

  @@index([feeId])
}

// id IS the business id ({branch}/p-00001); no separate prospectId.
model Prospect {
  id                   String    @id @db.NVarChar(50) // business id
  name                 String    @db.NVarChar(255)
  phone                String?   @db.NVarChar(255)
  whatsapp             String?   @db.NVarChar(255)
  gender               String?   @db.NVarChar(255)
  age                  Int?
  dob                  DateTime?
  interestedMembership String?   @db.NVarChar(255)
  branchId             String?   @db.NVarChar(50) // renamed from preferredBranchId
  branch               Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source               String    @db.NVarChar(255)
  status               String    @default("New") @db.NVarChar(255)
  inquiryDate          DateTime  @default(now())
  followUpDate         DateTime?
  assignedTo           String?   @db.NVarChar(255)
  notes                String?   @db.NVarChar(MAX)
  convertedMemberId    String?   @db.NVarChar(50)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([source])
  @@index([branchId])
}

// id IS the business id (f-000001, global sequence).
model MembershipFreeze {
  id         String   @id @db.NVarChar(50) // business id f-000001
  memberId   String   @db.NVarChar(50)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId   String   @db.NVarChar(50)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  freezeFrom DateTime
  freezeTo   DateTime
  days       Int
  reason     String?  @db.NVarChar(MAX)
  approvedBy String?  @db.NVarChar(255)
  status     String   @default("Active") @db.NVarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([memberId])
}

// id IS the business id ({branch}/fw-000001).
model FollowUp {
  id               String    @id @db.NVarChar(50) // business id
  memberId         String?   @db.NVarChar(50)
  member           Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prospectId       String?   @db.NVarChar(50) // FK-less reference to the prospect business id
  branchId         String?   @db.NVarChar(50)
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date             DateTime  @default(now())
  type             String    @db.NVarChar(255)
  userId           String?   @db.NVarChar(50)
  notes            String?   @db.NVarChar(MAX)
  outcome          String?   @db.NVarChar(255)
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())

  @@index([memberId])
  @@index([prospectId])
}

// id IS the business id ({branch}/Pg-000001); branchId added NOT NULL.
model ProgressEntry {
  id        String   @id @db.NVarChar(50) // business id
  memberId  String   @db.NVarChar(50)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId  String   @db.NVarChar(50)
  branch    Branch   @relation("ProgressEntryBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime @default(now())
  weight    Float?
  chest     Float?
  waist     Float?
  hips      Float?
  biceps    Float?
  thighs    Float?
  notes     String?  @db.NVarChar(MAX)
  photo     String?  @db.NVarChar(255)
  createdAt DateTime @default(now())

  @@index([memberId, date])
}

// =================================================================
// GYM MASTERS
// =================================================================

// Gym master file: categories are 3-digit ids ('001' Exercise, '002' Equipment,
// '003' Exercise Type); items are {masterId}{4-digit seq} (e.g. 0010001).
model GymMasterFile {
  id          String          @id @db.NVarChar(50) // 3-digit category or 7-digit item
  name        String          @db.NVarChar(255)
  level       Int // 1 = category, 2 = item
  parentCode  String?         @db.NVarChar(50) // category of an item
  parent      GymMasterFile?  @relation("GymMasterFileHierarchy", fields: [parentCode], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    GymMasterFile[] @relation("GymMasterFileHierarchy")
  branchId    String?         @db.NVarChar(50) // branch-wise (equipment items)
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String?         @db.NVarChar(MAX)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("gymmasterfile")
}

// id IS the business id (WO-000001, global sequence).
model WorkoutPlan {
  id          String   @id @db.NVarChar(50) // business id WO-000001
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  isGeneral   Boolean  @default(true)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days        WorkoutDay[]
  assignments WorkoutAssignment[]
}

model WorkoutDay {
  id        String               @id @default(cuid()) @db.NVarChar(50)
  planId    String               @db.NVarChar(50)
  plan      WorkoutPlan          @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayName   String               @db.NVarChar(255)
  notes     String?              @db.NVarChar(MAX)
  exercises WorkoutDayExercise[]
}

// Exercises live in the Gym Master File (gymmaster category '001' +
// gymmasterdetail items); workout days reference those detail items directly.
model WorkoutDayExercise {
  id         String          @id @default(cuid()) @db.NVarChar(50)
  dayId      String          @db.NVarChar(50)
  day        WorkoutDay      @relation(fields: [dayId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exerciseId String          @db.NVarChar(50)
  exercise   GymMasterDetail @relation("WorkoutDayExerciseItem", fields: [exerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sets       Int?
  reps       String?         @db.NVarChar(255)
  duration   String?         @db.NVarChar(255)
  rest       String?         @db.NVarChar(255)
  notes      String?         @db.NVarChar(MAX)
}

model WorkoutAssignment {
  id        String       @id @default(cuid()) @db.NVarChar(50)
  memberId  String       @db.NVarChar(50)
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId    String?      @db.NVarChar(50)
  plan      WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainerId String?      @db.NVarChar(50)
  startDate DateTime     @default(now())
  endDate   DateTime?
  notes     String?      @db.NVarChar(MAX)
  createdAt DateTime     @default(now())

  @@index([memberId])
}

// id IS the business id (DP-000001, global sequence).
model DietPlan {
  id          String   @id @db.NVarChar(50) // business id DP-000001
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meals       DietMeal[]
  assignments DietAssignment[]
}

model DietMeal {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  planId    String   @db.NVarChar(50)
  plan      DietPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek String   @db.NVarChar(255) // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
  timing    String   @db.NVarChar(255) // Breakfast, Brunch, Lunch, Snack, Dinner, Late Night, Pre Workout, Post Workout
  foods     String?  @db.NVarChar(255) // max 60 chars per spec (enforced in app + API)
  quantity  String?  @db.NVarChar(255)
  calories  Float?
  protein   Float?
  carbs     Float?
  fat       Float?
  notes     String?  @db.NVarChar(MAX)

  @@index([planId, dayOfWeek])
}

model DietAssignment {
  id        String    @id @default(cuid()) @db.NVarChar(50)
  memberId  String    @db.NVarChar(50)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId    String    @db.NVarChar(50)
  plan      DietPlan  @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?   @db.NVarChar(MAX)
  createdAt DateTime  @default(now())

  @@index([memberId])
}

// =================================================================
// MASTER FILES — three IDENTICAL master/detail pairs, one per module.
//   gymmaster     / gymmasterdetail       (Gym module)
//   financemaster / financemasterdetail   (Finance module)
//   payrollmaster / payrollmasterdetail   (HR & Payroll module)
// master.id  = 3-digit category code ('001' Exercises, '002' Equipment, ...)
// detail.id  = master code + 3-digit sequence ('0010001' Bench Press)
// Structures are intentionally identical across all three pairs.
// =================================================================

model GymMaster {
  id          String   @id @db.NVarChar(50) // category code, e.g. '001'
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation("GymMasterBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  details GymMasterDetail[]

  @@map("gymmaster")
}

model GymMasterDetail {
  id          String    @id @db.NVarChar(50) // item code = master code + seq, e.g. '0010001'
  masterId    String    @db.NVarChar(50)
  master      GymMaster @relation(fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String    @db.NVarChar(255)
  description String?   @db.NVarChar(MAX)
  branchId    String?   @db.NVarChar(50)
  branch      Branch?   @relation("GymMasterDetailBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workoutDayExercises WorkoutDayExercise[] @relation("WorkoutDayExerciseItem")

  @@index([masterId])
  @@map("gymmasterdetail")
}

model FinanceMaster {
  id          String   @id @db.NVarChar(50) // category code, e.g. '001'
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation("FinanceMasterBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  details FinanceMasterDetail[]

  @@map("financemaster")
}

model FinanceMasterDetail {
  id          String        @id @db.NVarChar(50) // item code = master code + seq, e.g. '0010001'
  masterId    String        @db.NVarChar(50)
  master      FinanceMaster @relation(fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String        @db.NVarChar(255)
  description String?       @db.NVarChar(MAX)
  branchId    String?       @db.NVarChar(50)
  branch      Branch?       @relation("FinanceMasterDetailBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([masterId])
  @@map("financemasterdetail")
}

model PayrollMaster {
  id          String   @id @db.NVarChar(50) // category code, e.g. '001'
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation("PayrollMasterBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  details PayrollMasterDetail[]

  @@map("payrollmaster")
}

model PayrollMasterDetail {
  id          String        @id @db.NVarChar(50) // item code = master code + seq, e.g. '0010001'
  masterId    String        @db.NVarChar(50)
  master      PayrollMaster @relation(fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String        @db.NVarChar(255)
  description String?       @db.NVarChar(MAX)
  branchId    String?       @db.NVarChar(50)
  branch      Branch?       @relation("PayrollMasterDetailBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([masterId])
  @@map("payrollmasterdetail")
}

// =================================================================
// EQUIPMENT + INVENTORY
// =================================================================

model Equipment {
  id            String    @id @default(cuid()) @db.NVarChar(50)
  code          String    @db.NVarChar(255)
  name          String    @db.NVarChar(255)
  category      String    @db.NVarChar(255)
  description   String?   @db.NVarChar(MAX)
  purchaseDate  DateTime?
  purchasePrice Float?
  quantity      Int       @default(1)
  condition     String    @default("Working") @db.NVarChar(MAX)
  status        String    @default("Active") @db.NVarChar(255)
  branchId      String    @db.NVarChar(50)
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billReference String?   @db.NVarChar(255)
  billImage     String?   @db.NVarChar(255)
  image         String?   @db.NVarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  maintenance EquipmentMaintenance[]
}

model EquipmentMaintenance {
  id          String    @id @default(cuid()) @db.NVarChar(50)
  equipmentId String    @db.NVarChar(50)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date        DateTime  @default(now())
  type        String    @db.NVarChar(255)
  description String?   @db.NVarChar(MAX)
  cost        Float     @default(0)
  vendor      String?   @db.NVarChar(255)
  notes       String?   @db.NVarChar(MAX)
  attachment  String?   @db.NVarChar(255)
  createdAt   DateTime  @default(now())

  @@index([equipmentId])
}

model InventoryItem {
  id            String   @id @default(cuid()) @db.NVarChar(50)
  code          String   @db.NVarChar(255)
  name          String   @db.NVarChar(255)
  category      String?  @db.NVarChar(255)
  description   String?  @db.NVarChar(MAX)
  unit          String?  @db.NVarChar(255)
  quantity      Int      @default(0)
  reorderLevel  Int      @default(0)
  purchasePrice Float?
  salePrice     Float?
  branchId      String   @db.NVarChar(50)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status        String   @default("Active") @db.NVarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posLines       PosSaleLine[]
  stockMovements StockMovement[]
  purchaseLines  PurchaseLine[]
}

// =================================================================
// POS
// =================================================================

model PosSale {
  id               String   @id @default(cuid()) @db.NVarChar(50)
  saleNo           String   @unique @db.NVarChar(191)
  date             DateTime @default(now())
  branchId         String   @db.NVarChar(50)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashierId        String?  @db.NVarChar(50)
  total            Float
  paymentMethod    String   @db.NVarChar(255)
  paymentAccountId String?  @db.NVarChar(50)
  bookVoucherId    String?  @db.NVarChar(50) // CRV/BRV voucher number auto-posted on sale
  status           String   @default("Completed") @db.NVarChar(255)
  notes            String?  @db.NVarChar(MAX)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lines PosSaleLine[]
}

model PosSaleLine {
  id              String        @id @default(cuid()) @db.NVarChar(50)
  saleId          String        @db.NVarChar(50)
  sale            PosSale       @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryItemId String        @db.NVarChar(50)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity        Int
  unitPrice       Float
  amount          Float
}

// =================================================================
// STAFF + PAYROLL
// =================================================================

// id IS the employee id (EMP-00001 format) — the former id + employeeId
// pair was merged into ONE column per HR DB upgrade (09_upgrade_finance_hr.sql).
model Staff {
  id                 String   @id @db.NVarChar(50) // employee id, e.g. EMP-00001 (app-generated)
  firstName          String   @db.NVarChar(255)
  lastName           String?  @db.NVarChar(255)
  fatherGuardian     String?  @db.NVarChar(255)
  cnic               String?  @db.NVarChar(255)
  photo              String?  @db.NVarChar(255)
  address            String?  @db.NVarChar(MAX)
  emergencyContact   String?  @db.NVarChar(255)
  emergencyContactNo String?  @db.NVarChar(255)
  phone              String?  @db.NVarChar(255)
  whatsapp           String?  @db.NVarChar(255)
  telephone          String?  @db.NVarChar(255)
  fax                String?  @db.NVarChar(255)
  email              String?  @db.NVarChar(255)
  joiningDate        DateTime @default(now())
  department         String?  @db.NVarChar(255)
  designation        String?  @db.NVarChar(255)
  isTrainer          Boolean  @default(false)
  branchId           String   @db.NVarChar(50)
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId            String?  @db.NVarChar(50)
  shift              Shift?   @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  basicSalary        Float    @default(0)
  fuelAllowance      Float    @default(0)
  rentAllowance      Float    @default(0)
  houseAllowance     Float    @default(0)
  otherAllowance     Float    @default(0)
  sessi              Float    @default(0)
  eobi               Float    @default(0)
  fbrTaxNumber       String?  @db.NVarChar(255)
  overtimeAllowed    Boolean  @default(false)
  overtimeRate       Float    @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isDeleted          Boolean  @default(false)

  overtimes             Overtime[]
  leaves                Leave[]
  payrolls              Payroll[]
  trainerAvailabilities TrainerAvailability[]
  trainerSchedules      TrainerSchedule[]
  staffDocuments        StaffDocument[]
}

// id is a 3-digit sequence (001, 002, 003 …) generated by the app.
model Shift {
  id          String   @id @db.NVarChar(50) // 001, 002, 003 … (app-generated)
  name        String   @db.NVarChar(255)
  timeIn      String   @db.NVarChar(255)
  timeOut     String   @db.NVarChar(255)
  workingDays String   @db.NVarChar(255)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff Staff[]
}

// id is a 3-digit sequence (001, 002, 003 …) generated by the app.
model CalendarDay {
  id        String   @id @db.NVarChar(50) // 001, 002, 003 … (app-generated)
  date      DateTime @unique
  branchId  String?  @db.NVarChar(50)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dayType   String   @db.NVarChar(255)
  notes     String?  @db.NVarChar(MAX)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// id IS the business id (LV-0001); leaveType stores the type NAME matching
// payrollmasterfile.name where masterType = 'Leave Type'.
model Leave {
  id         String    @id @db.NVarChar(50) // business id LV-0001
  staffId    String    @db.NVarChar(50)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId   String    @db.NVarChar(50)
  branch     Branch    @relation("LeaveBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveType  String    @db.NVarChar(255)
  fromDate   DateTime
  toDate     DateTime
  days       Int
  reason     String?   @db.NVarChar(MAX)
  status     String    @default("Pending") @db.NVarChar(255)
  approvedBy String?   @db.NVarChar(255)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([staffId])
  @@index([branchId])
  @@index([status])
}

model Overtime {
  id         String    @id @default(cuid()) @db.NVarChar(50)
  staffId    String    @db.NVarChar(50)
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date       DateTime
  hours      Float
  rate       Float
  amount     Float
  status     String    @default("Pending") @db.NVarChar(255)
  approvedBy String?   @db.NVarChar(255)
  approvedAt DateTime?
  notes      String?   @db.NVarChar(MAX)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([staffId])
  @@index([status])
}

model Payroll {
  id              String   @id @default(cuid()) @db.NVarChar(50)
  payrollNo       String   @unique @db.NVarChar(191)
  staffId         String   @db.NVarChar(50)
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String   @db.NVarChar(50)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  month           Int
  year            Int
  basicSalary     Float
  totalAllowances Float
  overtimeAmount  Float
  totalEarnings   Float
  totalDeductions Float
  netPay          Float
  status          String   @default("Draft") @db.NVarChar(255)
  bookVoucherId   String?  @db.NVarChar(50) // CPV/BPV voucher number when salary posted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([staffId, month, year])
  @@index([branchId])
}

model Allowance {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  name        String   @unique @db.NVarChar(191)
  description String?  @db.NVarChar(MAX)
  isStatutory Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// HR payroll master file — table "payrollmasterfile". Master categories:
// Education, Designation, Country, Department, Shift, Leave Type, Allowance, ...
// (legacy earning/deduction heads are stored as masterType 'Earning'/'Deduction'
// with calcType/amount metadata in `extra`.)
model PayrollMasterFile {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  masterType  String   @db.NVarChar(255)
  name        String   @db.NVarChar(255)
  description String?  @db.NVarChar(MAX)
  extra       String?  @db.NVarChar(255) // JSON metadata (allowedDays/isPaid, calcType/amount, ...)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation("PayrollMasterFileBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([masterType, name])
  @@index([masterType])
  @@map("payrollmasterfile")
}

// =================================================================
// UNIVERSAL MASTER FILES — generic master record (Department, Designation, Education, Currency, etc.)
// =================================================================
model MasterFile {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  masterType  String   @db.NVarChar(255) // Department, Designation, Education, Currency, Allowance, Equipment, etc.
  code        String   @db.NVarChar(255) // auto-generated per masterType
  name        String   @db.NVarChar(255)
  branchId    String?  @db.NVarChar(50) // optional branch scoping
  branch      Branch?  @relation("MasterFileBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String?  @db.NVarChar(MAX)
  isActive    Boolean  @default(true)
  // optional extra fields stored as JSON for masters that need more (e.g. Currency has symbol, ExchangeRate)
  extra       String?  @db.NVarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([masterType, code])
  @@unique([masterType, name])
  @@index([masterType])
}

// =================================================================
// FITNESS MANAGEMENT
// =================================================================

model FitnessGoal {
  id          String    @id @default(cuid()) @db.NVarChar(50)
  memberId    String    @db.NVarChar(50)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  goalType    String    @db.NVarChar(255) // WeightLoss, MuscleBuilding, Strength, Bodybuilding, General, Other
  targetValue Float?
  unit        String?   @db.NVarChar(255)
  startDate   DateTime  @default(now())
  targetDate  DateTime?
  status      String    @default("Active") @db.NVarChar(255) // Active, Achieved, Abandoned
  notes       String?   @db.NVarChar(MAX)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([memberId])
}

model PersonalTrainingSession {
  id                String    @id @default(cuid()) @db.NVarChar(50)
  memberId          String    @db.NVarChar(50)
  member            Member    @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trainerId         String    @db.NVarChar(50)
  branchId          String?   @db.NVarChar(50)
  branch            Branch?   @relation("PTSessionBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessionsPurchased Int       @default(0)
  sessionsUsed      Int       @default(0)
  sessionsRemaining Int       @default(0)
  sessionDate       DateTime?
  sessionStatus     String    @default("Scheduled") @db.NVarChar(255) // Scheduled, Completed, Cancelled, NoShow
  startDate         DateTime?
  endDate           DateTime?
  notes             String?   @db.NVarChar(MAX)
  status            String    @default("Active") @db.NVarChar(255)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([memberId])
  @@index([trainerId])
}

model TrainerAvailability {
  id        String   @id @default(cuid()) @db.NVarChar(50)
  staffId   String   @db.NVarChar(50)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek String   @db.NVarChar(255) // Monday, Tuesday, etc.
  startTime String   @db.NVarChar(255)
  endTime   String   @db.NVarChar(255)
  branchId  String?  @db.NVarChar(50)
  branch    Branch?  @relation("TrainerAvailBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status    String   @default("Available") @db.NVarChar(255) // Available, Unavailable, Busy
  createdAt DateTime @default(now())

  @@index([staffId])
}

model TrainerSchedule {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  staffId     String   @db.NVarChar(50)
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId    String?  @db.NVarChar(50)
  branch      Branch?  @relation("TrainerSchedBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  dayOfWeek   String   @db.NVarChar(255)
  startTime   String   @db.NVarChar(255)
  endTime     String   @db.NVarChar(255)
  sessionType String   @db.NVarChar(255) // PersonalTraining, Class, GroupSession, Assessment
  memberId    String?  @db.NVarChar(50)
  classId     String?  @db.NVarChar(50)
  status      String   @default("Scheduled") @db.NVarChar(255) // Scheduled, Completed, Cancelled
  notes       String?  @db.NVarChar(MAX)
  createdAt   DateTime @default(now())

  @@index([staffId, date])
}

model StaffDocument {
  id           String    @id @default(cuid()) @db.NVarChar(50)
  staffId      String    @db.NVarChar(50)
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documentType String    @db.NVarChar(255) // CNIC, Contract, Certificate, Photo, Other
  documentName String    @db.NVarChar(255)
  fileUrl      String    @db.NVarChar(255)
  issueDate    DateTime?
  expiryDate   DateTime?
  status       String    @default("Active") @db.NVarChar(255)
  notes        String?   @db.NVarChar(MAX)
  uploadedBy   String?   @db.NVarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([staffId])
}

model FoodItem {
  id          String   @id @default(cuid()) @db.NVarChar(50)
  code        String   @db.NVarChar(255)
  name        String   @db.NVarChar(255)
  category    String?  @db.NVarChar(255)
  calories    Float    @default(0)
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  servingSize String?  @db.NVarChar(255)
  unit        String?  @db.NVarChar(255)
  status      String   @default("Active") @db.NVarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code])
}

// =================================================================
// INVENTORY EXTENSION
// =================================================================

model Supplier {
  id            String   @id @default(cuid()) @db.NVarChar(50)
  code          String   @db.NVarChar(255)
  name          String   @db.NVarChar(255)
  contactPerson String?  @db.NVarChar(255)
  phone         String?  @db.NVarChar(255)
  email         String?  @db.NVarChar(255)
  address       String?  @db.NVarChar(MAX)
  branchId      String?  @db.NVarChar(50)
  branch        Branch?  @relation("SupplierBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status        String   @default("Active") @db.NVarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id           String    @id @default(cuid()) @db.NVarChar(50)
  purchaseNo   String    @unique @db.NVarChar(191)
  supplierId   String?   @db.NVarChar(50)
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId     String    @db.NVarChar(50)
  branch       Branch    @relation("PurchaseBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseDate DateTime  @default(now())
  totalAmount  Float     @default(0)
  status       String    @default("Pending") @db.NVarChar(255) // Pending, Received, Cancelled
  notes        String?   @db.NVarChar(MAX)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PurchaseLine[]
}

model PurchaseLine {
  id              String         @id @default(cuid()) @db.NVarChar(50)
  purchaseId      String         @db.NVarChar(50)
  purchase        Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryItemId String?        @db.NVarChar(50)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  itemName        String         @db.NVarChar(255)
  quantity        Int            @default(0)
  unitPrice       Float          @default(0)
  amount          Float          @default(0)
}

model StockMovement {
  id              String        @id @default(cuid()) @db.NVarChar(50)
  inventoryItemId String        @db.NVarChar(50)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String        @db.NVarChar(50)
  branch          Branch        @relation("StockMoveBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movementType    String        @db.NVarChar(255) // PurchaseIn, PurchaseReturn, StockIn, StockOut, Adjustment, Transfer
  quantity        Int
  reference       String?       @db.NVarChar(255)
  referenceId     String?       @db.NVarChar(50)
  date            DateTime      @default(now())
  notes           String?       @db.NVarChar(MAX)
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([branchId, date])
}
