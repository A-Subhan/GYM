// Contoura Gym Management System — full ERP schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =================================================================
// CORE
// =================================================================

model Company {
  id             String @db.NVarChar(50)   @id @default(cuid())
  companyId      String @db.NVarChar(50)   @unique
  name           String @db.NVarChar(255)
  address        String? @db.NVarChar(MAX)
  phone          String? @db.NVarChar(255)
  email          String? @db.NVarChar(255)
  website        String? @db.NVarChar(255)
  logo           String? @db.NVarChar(255)
  accountingType String @db.NVarChar(255)   @default("FIFO")
  strn           String? @db.NVarChar(255)
  ntn            String? @db.NVarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Branch {
  id        String @db.NVarChar(50)   @id @default(cuid())
  code      String @db.NVarChar(191)   @unique
  name      String @db.NVarChar(255)
  address   String? @db.NVarChar(MAX)
  city      String? @db.NVarChar(255)
  phone     String? @db.NVarChar(255)
  email     String? @db.NVarChar(255)
  strn      String? @db.NVarChar(255)
  ntn       String? @db.NVarChar(255)
  logo      String? @db.NVarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  users              User[]
  accounts           Account[]
  members            Member[]
  attendance         Attendance[]
  fees               Fee[]
  equipment          Equipment[]
  inventory          InventoryItem[]
  prospects          Prospect[]
  exercises          Exercise[]
  workoutPlans       WorkoutPlan[]
  dietPlans          DietPlan[]
  staff              Staff[]
  shifts             Shift[]
  calendar           CalendarDay[]
  vouchers           Voucher[]
  taxHeads           TaxHead[]
  payroll            Payroll[]
  posSales           PosSale[]
  followUps          FollowUp[]
  freezes            MembershipFreeze[]
  // New relations from extended models
  fitnessAssessments  FitnessAssessment[]
  trainerAvailabilities TrainerAvailability[] @relation("TrainerAvailBranch")
  trainerSchedules   TrainerSchedule[] @relation("TrainerSchedBranch")
  ptSessions         PersonalTrainingSession[] @relation("PTSessionBranch")
  gymClasses          GymClass[] @relation("ClassBranch")
  suppliers           Supplier[] @relation("SupplierBranch")
  purchases           Purchase[] @relation("PurchaseBranch")
  stockMovements      StockMovement[] @relation("StockMoveBranch")
}

model Role {
  id          String @db.NVarChar(50)   @id @default(cuid())
  name        String @db.NVarChar(191)   @unique
  description String? @db.NVarChar(MAX)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String @db.NVarChar(50)  @id @default(cuid())
  module      String @db.NVarChar(255)
  action      String @db.NVarChar(255)
  code        String @db.NVarChar(191)  @unique
  description String? @db.NVarChar(MAX)

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.NVarChar(50)
  permissionId String @db.NVarChar(50)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model User {
  id                 String @db.NVarChar(50)   @id @default(cuid())
  username           String @db.NVarChar(191)   @unique
  email              String? @db.NVarChar(191)  @unique
  fullName           String @db.NVarChar(255)
  passwordHash       String @db.NVarChar(255)
  roleId             String @db.NVarChar(50)
  role               Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId           String? @db.NVarChar(50)
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accessibleBranchIds String @db.NVarChar(255)  @default("*")
  phone              String? @db.NVarChar(255)
  photo              String? @db.NVarChar(255)
  isActive           Boolean  @default(true)
  failedLoginCount   Int      @default(0)
  lastLoginAt        DateTime?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isDeleted          Boolean  @default(false)

  sessions  Session[]
  auditLogs AuditLog[]
}

model Session {
  id           String @db.NVarChar(50)   @id @default(cuid())
  userId       String @db.NVarChar(50)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshToken String @db.NVarChar(255)
  ipAddress    String? @db.NVarChar(255)
  userAgent    String? @db.NVarChar(255)
  location     String? @db.NVarChar(255)
  status       String @db.NVarChar(255)   @default("Active")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model AuditLog {
  id        String @db.NVarChar(50)   @id @default(cuid())
  userId    String? @db.NVarChar(50)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String @db.NVarChar(255)
  module    String @db.NVarChar(255)
  details   String? @db.NVarChar(MAX)
  ipAddress String? @db.NVarChar(255)
  location  String? @db.NVarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// =================================================================
// FINANCE
// =================================================================

model Account {
  id                 String @db.NVarChar(50)   @id @default(cuid())
  code               String @db.NVarChar(255)
  name               String @db.NVarChar(255)
  parentId           String? @db.NVarChar(50)
  parent             Account? @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           Account[] @relation("AccountHierarchy")
  accountType        String @db.NVarChar(255)
  bookType           String? @db.NVarChar(255)
  accountTag         String? @db.NVarChar(255)
  isControl         Boolean  @default(false)
  isDetail          Boolean  @default(true)
  isActive          Boolean  @default(true)
  branchId          String? @db.NVarChar(50)
  branch            Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactName       String? @db.NVarChar(255)
  phone             String? @db.NVarChar(255)
  email             String? @db.NVarChar(255)
  address           String? @db.NVarChar(MAX)
  bankName          String? @db.NVarChar(255)
  bankAccountNo     String? @db.NVarChar(255)
  bankBranch        String? @db.NVarChar(255)
  cnic              String? @db.NVarChar(255)
  ntn               String? @db.NVarChar(255)
  description       String? @db.NVarChar(MAX)
  openingBalance    Float    @default(0)
  openingBalanceType String? @db.NVarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines             VoucherLine[]
  bookVouchers      Voucher[] @relation("VoucherBookAccount")
  mappings          AccountMapping[]

  @@index([code])
  @@index([parentId])
  @@index([branchId])
}

model FinancialYear {
  id        String @db.NVarChar(50)   @id @default(cuid())
  name      String @db.NVarChar(191)   @unique
  startDate DateTime
  endDate   DateTime
  isActive Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods AccountingPeriod[]
}

model AccountingPeriod {
  id               String @db.NVarChar(50)   @id @default(cuid())
  financialYearId  String @db.NVarChar(50)
  financialYear    FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name             String @db.NVarChar(255)
  startDate        DateTime
  endDate          DateTime
  status           String @db.NVarChar(255)   @default("Open")
  createdAt        DateTime @default(now())

  @@index([financialYearId])
}

model TaxHead {
  id         String @db.NVarChar(50)   @id @default(cuid())
  code       String @db.NVarChar(255)
  shortName  String @db.NVarChar(255)
  name       String @db.NVarChar(255)
  taxType    String @db.NVarChar(255)
  rate       Float
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([code])
}

model Voucher {
  id           String @db.NVarChar(50)   @id @default(cuid())
  voucherNo    String @db.NVarChar(191)   @unique
  voucherType  String @db.NVarChar(255)
  voucherDate  DateTime
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookAccountId String? @db.NVarChar(50)
  bookAccount  Account? @relation("VoucherBookAccount", fields: [bookAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description  String? @db.NVarChar(MAX)
  reference    String? @db.NVarChar(255)
  status       String @db.NVarChar(255)   @default("Draft")
  postedById   String? @db.NVarChar(50)
  postedAt     DateTime?
  reversedById String? @db.NVarChar(50)
  reversedAt   DateTime?
  reversalReason String? @db.NVarChar(255)
  totalDebit   Float    @default(0)
  totalCredit  Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      VoucherLine[]
  cheques    Cheque[]
  feePayments FeePayment[]
  fees       Fee[]     @relation("FeeVoucher")
  payrolls   Payroll[]

  @@index([voucherType])
  @@index([voucherDate])
  @@index([branchId])
  @@index([status])
}

model VoucherLine {
  id         String @db.NVarChar(50)   @id @default(cuid())
  voucherId  String @db.NVarChar(50)
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId  String @db.NVarChar(50)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lineDescription String? @db.NVarChar(255)
  title      String? @db.NVarChar(255)
  reference  String? @db.NVarChar(255)
  amount     Float    @default(0)
  debit      Float    @default(0)
  credit     Float    @default(0)
  taxAccountId String? @db.NVarChar(50)
  taxRate    Float    @default(0)
  taxAmount  Float    @default(0)
  chequeNo   String? @db.NVarChar(255)
  chequeAmount Float?
  chequeBankName String? @db.NVarChar(255)
  chequeStatus String? @db.NVarChar(255)
  status     String @db.NVarChar(255)   @default("Active")
  createdAt  DateTime @default(now())

  @@index([voucherId])
  @@index([accountId])
}

model Cheque {
  id         String @db.NVarChar(50)   @id @default(cuid())
  voucherId  String @db.NVarChar(50)
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chequeNo   String @db.NVarChar(255)
  chequeDate DateTime
  bankName   String? @db.NVarChar(255)
  amount     Float
  status     String @db.NVarChar(255)   @default("Hold")
  statusChangedAt DateTime?
  statusChangedBy String? @db.NVarChar(255)
  statusHistory String? @db.NVarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([chequeNo])
}

model AccountMapping {
  id          String @db.NVarChar(50)   @id @default(cuid())
  branchId    String? @db.NVarChar(50)
  key         String @db.NVarChar(255)
  accountId   String @db.NVarChar(50)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String? @db.NVarChar(MAX)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, key])
  @@index([key])
}

model FinanceDefaults {
  id              String @db.NVarChar(50)   @id @default(cuid())
  branchId        String? @db.NVarChar(50)  @unique
  defaultCashAccountId String? @db.NVarChar(50)
  defaultBankAccountId String? @db.NVarChar(50)
  defaultTaxHeadId String? @db.NVarChar(50)
  financialYearId String? @db.NVarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserReportFormat {
  id        String @db.NVarChar(50)   @id @default(cuid())
  userId    String @db.NVarChar(50)
  reportKey String @db.NVarChar(255)
  name      String @db.NVarChar(255)
  columns   String @db.NVarChar(255)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportKey, name])
  @@index([userId, reportKey])
}

// =================================================================
// GYM
// =================================================================

model Member {
  id              String @db.NVarChar(50)   @id @default(cuid())
  memberId        String @db.NVarChar(50)   @unique
  firstName       String @db.NVarChar(255)
  lastName        String? @db.NVarChar(255)
  gender          String? @db.NVarChar(255)
  dob             DateTime?
  phone           String? @db.NVarChar(255)
  whatsapp        String? @db.NVarChar(255)
  email           String? @db.NVarChar(255)
  address         String? @db.NVarChar(MAX)
  emergencyContact String? @db.NVarChar(255)
  emergencyContactNo String? @db.NVarChar(255)
  photo           String? @db.NVarChar(255)
  cnic            String? @db.NVarChar(255)
  joiningDate     DateTime @default(now())
  billingStartDate DateTime?
  feeRelaxationDays Int @default(0)
  status          String @db.NVarChar(255)   @default("Active")
  membershipPlanId String? @db.NVarChar(50)
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String @db.NVarChar(50)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTrainerId String? @db.NVarChar(50)
  notes           String? @db.NVarChar(MAX)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  attendance         Attendance[]
  fees               Fee[]
  progress           ProgressEntry[]
  freezes            MembershipFreeze[]
  followUps          FollowUp[]
  workoutAssignments WorkoutAssignment[]
  dietAssignments    DietAssignment[]
  fitnessGoals       FitnessGoal[]
  fitnessAssessments  FitnessAssessment[]
  ptSessions         PersonalTrainingSession[]
  classEnrollments   ClassEnrollment[] @relation("ClassEnrollmentMember")
  memberDocuments    MemberDocument[]

  @@index([branchId])
  @@index([status])
  @@index([phone])
}

model MembershipPlan {
  id           String @db.NVarChar(50)   @id @default(cuid())
  code          String @db.NVarChar(191)   @unique
  name          String @db.NVarChar(255)
  durationDays  Int
  amount        Float
  description   String? @db.NVarChar(MAX)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      Member[]
}

model Attendance {
  id         String @db.NVarChar(50)   @id @default(cuid())
  memberId   String @db.NVarChar(50)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId   String @db.NVarChar(50)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String? @db.NVarChar(MAX)
  createdAt  DateTime @default(now())

  @@unique([memberId, date])
  @@index([branchId, date])
}

model Fee {
  id           String @db.NVarChar(50)   @id @default(cuid())
  feeNo        String @db.NVarChar(191)   @unique
  memberId     String @db.NVarChar(50)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  amount       Float
  discount     Float    @default(0)
  paidAmount   Float    @default(0)
  balance      Float    @default(0)
  dueDate      DateTime
  status       String @db.NVarChar(255)   @default("Unpaid")
  paymentMethod String? @db.NVarChar(255)
  paymentAccountId String? @db.NVarChar(50)
  paymentDate  DateTime?
  reference    String? @db.NVarChar(255)
  voucherId    String? @db.NVarChar(50)
  voucher      Voucher? @relation("FeeVoucher", fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     FeePayment[]

  @@index([memberId])
  @@index([branchId])
  @@index([status])
  @@index([dueDate])
}

model FeePayment {
  id         String @db.NVarChar(50)   @id @default(cuid())
  feeId      String @db.NVarChar(50)
  fee        Fee       @relation(fields: [feeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  voucherId  String @db.NVarChar(50)
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount     Float
  method     String @db.NVarChar(255)   // Cash | Card | Bank Transfer | Online
  accountId  String @db.NVarChar(50)
  cardTypeId String? @db.NVarChar(50)  // MasterFile id (masterType = 'CardTypes') when method = Card
  cardTypeName String? @db.NVarChar(255) // snapshot of card type name at time of payment (preserved if master is deactivated)
  bankMasterId String? @db.NVarChar(50) // MasterFile id (masterType = 'Banks') when method = Bank Transfer
  bankMasterName String? @db.NVarChar(255) // snapshot of bank name at time of payment
  createdAt  DateTime @default(now())

  @@index([feeId])
}

model Prospect {
  id         String @db.NVarChar(50)   @id @default(cuid())
  prospectId String @db.NVarChar(50)   @unique
  name       String @db.NVarChar(255)
  phone      String? @db.NVarChar(255)
  whatsapp   String? @db.NVarChar(255)
  gender     String? @db.NVarChar(255)
  age        Int?
  dob        DateTime?
  interestedMembership String? @db.NVarChar(255)
  preferredBranchId String? @db.NVarChar(50)
  preferredBranch  Branch? @relation(fields: [preferredBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source     String @db.NVarChar(255)
  status     String @db.NVarChar(255)   @default("New")
  inquiryDate DateTime @default(now())
  followUpDate DateTime?
  assignedTo String? @db.NVarChar(255)
  notes      String? @db.NVarChar(MAX)
  convertedMemberId String? @db.NVarChar(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model MembershipFreeze {
  id         String @db.NVarChar(50)   @id @default(cuid())
  memberId   String @db.NVarChar(50)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId   String @db.NVarChar(50)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  freezeFrom DateTime
  freezeTo   DateTime
  days       Int
  reason     String? @db.NVarChar(MAX)
  approvedBy String? @db.NVarChar(255)
  status     String @db.NVarChar(255)   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([memberId])
}

model FollowUp {
  id         String @db.NVarChar(50)   @id @default(cuid())
  memberId   String? @db.NVarChar(50)
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prospectId String? @db.NVarChar(50)
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date       DateTime @default(now())
  type       String @db.NVarChar(255)
  userId     String? @db.NVarChar(50)
  notes      String? @db.NVarChar(MAX)
  outcome    String? @db.NVarChar(255)
  nextFollowUpDate DateTime?
  createdAt  DateTime @default(now())

  @@index([memberId])
  @@index([prospectId])
}

// =================================================================
// GYM MASTERS
// =================================================================

model Exercise {
  id         String @db.NVarChar(50)   @id @default(cuid())
  code       String @db.NVarChar(255)
  name       String @db.NVarChar(255)
  category   String? @db.NVarChar(255)
  muscleGroup String? @db.NVarChar(255)
  instructions String? @db.NVarChar(MAX)
  sets       Int?
  reps       String? @db.NVarChar(255)
  duration   String? @db.NVarChar(255)
  rest       String? @db.NVarChar(255)
  equipment  String? @db.NVarChar(255)
  image      String? @db.NVarChar(255)
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status     String @db.NVarChar(255)   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dayExercises WorkoutDayExercise[]
}

model WorkoutPlan {
  id         String @db.NVarChar(50)   @id @default(cuid())
  name       String @db.NVarChar(255)
  description String? @db.NVarChar(MAX)
  isGeneral  Boolean  @default(true)
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  days       WorkoutDay[]
  assignments WorkoutAssignment[]
}

model WorkoutDay {
  id         String @db.NVarChar(50)   @id @default(cuid())
  planId     String @db.NVarChar(50)
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayName    String @db.NVarChar(255)
  notes      String? @db.NVarChar(MAX)
  exercises  WorkoutDayExercise[]
}

model WorkoutDayExercise {
  id          String @db.NVarChar(50)  @id @default(cuid())
  dayId       String @db.NVarChar(50)
  day         WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exerciseId  String @db.NVarChar(50)
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sets        Int?
  reps        String? @db.NVarChar(255)
  duration    String? @db.NVarChar(255)
  rest        String? @db.NVarChar(255)
  notes       String? @db.NVarChar(MAX)
}

model WorkoutAssignment {
  id         String @db.NVarChar(50)   @id @default(cuid())
  memberId   String @db.NVarChar(50)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  planId     String? @db.NVarChar(50)
