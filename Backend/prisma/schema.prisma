model MasterFile {
  id         String @db.NVarChar(50)   @id @default(cuid())
  masterType String @db.NVarChar(255)   // Department, Designation, Education, Currency, Allowance, LeaveType, Equipment, etc.
  code       String @db.NVarChar(255)   // auto-generated per masterType
  name       String @db.NVarChar(255)
  branchId   String? @db.NVarChar(50)   // optional branch scoping (e.g. gym equipment master per branch)
  branch     Branch?  @relation("MasterFileBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String? @db.NVarChar(MAX)
  isActive   Boolean  @default(true)
  // optional extra fields stored as JSON for masters that need more (e.g. Currency has symbol, ExchangeRate)
  extra      String? @db.NVarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([masterType, code])
  @@unique([masterType, name])
  @@index([masterType])
}

