// =================================================================
model MasterFile {
  id         String @db.NVarChar(50)   @id @default(cuid())
  masterType String @db.NVarChar(255)   // Department, Designation, Education, Currency, Allowance, LeaveType, etc.
  code       String @db.NVarChar(255)   // auto-generated per masterType
  name       String @db.NVarChar(255)
  description String? @db.NVarChar(MAX)
  isActive   Boolean  @default(true)
  // optional extra fields stored as JSON for masters that need more (e.g. Currency has symbol, ExchangeRate)
