// Contoura Gym Management System — full ERP schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =================================================================
// CORE
// =================================================================

model Company {
  id             String @db.NVarChar(50)   @id @default(cuid())
  companyId      String @db.NVarChar(50)   @unique
  name           String @db.NVarChar(255)
  nameLocked     Boolean  @default(false)  // company name can only be set once (Defaults page)
  address        String? @db.NVarChar(MAX)
  phone          String? @db.NVarChar(255)
  email          String? @db.NVarChar(255)
  website        String? @db.NVarChar(255)
  logo           String? @db.NVarChar(255)
  accountingType String @db.NVarChar(255)   @default("FIFO")
  strn           String? @db.NVarChar(255)
  ntn            String? @db.NVarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Branch {
  id        String @db.NVarChar(50)   @id @default(cuid())
  code      String @db.NVarChar(191)   @unique
  name      String @db.NVarChar(255)
  parentId  String? @db.NVarChar(50)
  parent    Branch?  @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Branch[] @relation("BranchHierarchy")
  nodeType  String   @default("Detail")  // Control | Detail (hierarchical Branch File)
  address   String? @db.NVarChar(MAX)
  city      String? @db.NVarChar(255)
  phone     String? @db.NVarChar(255)
  email     String? @db.NVarChar(255)
  strn      String? @db.NVarChar(255)
  ntn       String? @db.NVarChar(255)
  logo      String? @db.NVarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  users              User[]
  charts             Chart[]
  members            Member[]
  attendance         Attendance[]
  fees               Fee[]
  equipment          Equipment[]
  inventory          InventoryItem[]
  prospects          Prospect[]
  exercises          Exercise[]
  workoutPlans       WorkoutPlan[]
  dietPlans          DietPlan[]
  staff              Staff[]
  shifts             Shift[]
  calendar           CalendarDay[]
  taxHeads           TaxHead[]
  payroll            Payroll[]
  posSales           PosSale[]
  followUps          FollowUp[]
  freezes            MembershipFreeze[]
  // New relations from extended models
  trainerAvailabilities TrainerAvailability[] @relation("TrainerAvailBranch")
  trainerSchedules   TrainerSchedule[] @relation("TrainerSchedBranch")
  ptSessions         PersonalTrainingSession[] @relation("PTSessionBranch")
  suppliers           Supplier[] @relation("SupplierBranch")
  purchases           Purchase[] @relation("PurchaseBranch")
  stockMovements      StockMovement[] @relation("StockMoveBranch")
  cashbookVouchers    CashbookVoucher[] @relation("CashbookBranch")
  bankbookVouchers    BankbookVoucher[] @relation("BankbookBranch")
  journalVouchers     JournalVoucher[]  @relation("JournalBranch")
  openTbVouchers      OpenTbVoucher[]   @relation("OpenTbBranch")
  leaves              Leave[]           @relation("LeaveBranch")
  masterFiles         MasterFile[]      @relation("MasterFileBranch")
}

model Role {
  id          String @db.NVarChar(50)   @id @default(cuid())
  name        String @db.NVarChar(191)   @unique
  description String? @db.NVarChar(MAX)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  screenPermissions ScreenPermission[]
}

// Per-screen permissions: 52 screens x View/Add/Edit/Delete/Print, applied at session level
model ScreenPermission {
  id       String @db.NVarChar(50) @id @default(cuid())
  roleId   String @db.NVarChar(50)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  screenKey String @db.NVarChar(255)
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canPrint  Boolean @default(false)

  @@unique([roleId, screenKey])
  @@index([screenKey])
}

model Permission {
  id          String @db.NVarChar(50)  @id @default(cuid())
  module      String @db.NVarChar(255)
  action      String @db.NVarChar(255)
  code        String @db.NVarChar(191)  @unique
  description String? @db.NVarChar(MAX)

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.NVarChar(50)
  permissionId String @db.NVarChar(50)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
}

model User {
  id                 String @db.NVarChar(50)   @id @default(cuid())
  username           String @db.NVarChar(191)   @unique
  email              String? @db.NVarChar(191)  @unique
  fullName           String @db.NVarChar(255)
  passwordHash       String @db.NVarChar(255)
  roleId             String @db.NVarChar(50)
  role               Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId           String? @db.NVarChar(50)
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accessibleBranchIds String @db.NVarChar(255)  @default("*")
  phone              String? @db.NVarChar(255)
  photo              String? @db.NVarChar(255)
  isActive           Boolean  @default(true)
  failedLoginCount   Int      @default(0)
  lastLoginAt        DateTime?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isDeleted          Boolean  @default(false)

  sessions  Session[]
  auditLogs AuditLog[]
}

model Session {
  id           String @db.NVarChar(50)   @id @default(cuid())
  userId       String @db.NVarChar(50)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshToken String @db.NVarChar(255)
  ipAddress    String? @db.NVarChar(255)
  userAgent    String? @db.NVarChar(255)
  location     String? @db.NVarChar(255)
  status       String @db.NVarChar(255)   @default("Active")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model AuditLog {
  id        String @db.NVarChar(50)   @id @default(cuid())
  userId    String? @db.NVarChar(50)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String @db.NVarChar(255)
  module    String @db.NVarChar(255)
  details   String? @db.NVarChar(MAX)
  ipAddress String? @db.NVarChar(255)
  location  String? @db.NVarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// =================================================================
// FINANCE
// =================================================================

// Chart of Accounts - table renamed to "charts" per spec; id IS the account code.
model Chart {
  id                 String @db.NVarChar(50)   @id   // id = account code (e.g. 1000, 1000-001)
  name               String @db.NVarChar(255)
  parentId           String? @db.NVarChar(50)
  parent             Chart? @relation("ChartHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           Chart[] @relation("ChartHierarchy")
  accountType        String @db.NVarChar(255)
  bookType           String? @db.NVarChar(255)
  accountTag         String? @db.NVarChar(255)
  isControl          Boolean  @default(false)
  isDetail           Boolean  @default(true)
  isActive           Boolean  @default(true)
  branchId           String? @db.NVarChar(50)
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactName        String? @db.NVarChar(255)
  phone              String? @db.NVarChar(255)
  email              String? @db.NVarChar(255)
  address            String? @db.NVarChar(MAX)
  bankName           String? @db.NVarChar(255)
  bankAccountNo      String? @db.NVarChar(255)
  bankBranch         String? @db.NVarChar(255)
  cnic               String? @db.NVarChar(255)
  strn               String? @db.NVarChar(255)
  ntn                String? @db.NVarChar(255)
  fbr                String? @db.NVarChar(255)
  paymentTerms       String? @db.NVarChar(255)
  description        String? @db.NVarChar(MAX)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lines             BookVoucherLine[]
  mappings          AccountMapping[]
  cashbookBookVouchers CashbookVoucher[] @relation("CashbookBookAccount")
  bankbookBookVouchers BankbookVoucher[] @relation("BankbookBookAccount")
  knockOffs         KnockOff[]

  @@index([parentId])
  @@index([branchId])
  @@index([accountType])
}

// =================================================================
// DEDICATED BOOK VOUCHERS (replace generic Voucher)
// id = voucher number, format {TYPE}/{branchCode}/{MMMyy}/{000001}
// CashbookVoucher: CRV (Cash Receipt) + CPV (Cash Payment)
// BankbookVoucher: BRV (Bank Receipt) + BPV (Bank Payment)
// JournalVoucher : JV
// OpenTbVoucher  : OTV (Opening Trial Balance; allows unbalanced save + knock-off)
// Reversals append -R to the id.
// =================================================================

model CashbookVoucher {
  id           String @db.NVarChar(50)   @id   // voucher number, e.g. CRV/MAIN/Sep25/000001
  voucherType  String @db.NVarChar(255)   // CRV | CPV
  voucherDate  DateTime
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation("CashbookBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookChartId  String   @db.NVarChar(50)   // cash book account (charts.id)
  bookChart    Chart    @relation("CashbookBookAccount", fields: [bookChartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description  String? @db.NVarChar(MAX)
  reference    String? @db.NVarChar(255)
  paymentMode  String? @db.NVarChar(255)   // Cash | Cheque
  totalAmount  Float    @default(0)
  status       String @db.NVarChar(255)   @default("Posted")  // Posted | Reversed
  reversedById String? @db.NVarChar(50)
  reversedAt   DateTime?
  reversalReason String? @db.NVarChar(255)
  postedById   String? @db.NVarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      BookVoucherLine[] @relation("CashbookLines")

  @@index([voucherType])
  @@index([voucherDate])
  @@index([branchId])
}

model BankbookVoucher {
  id           String @db.NVarChar(50)   @id   // voucher number, e.g. BPV/MAIN/Sep25/000001
  voucherType  String @db.NVarChar(255)   // BRV | BPV
  voucherDate  DateTime
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation("BankbookBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookChartId  String   @db.NVarChar(50)   // bank book account (charts.id)
  bookChart    Chart    @relation("BankbookBookAccount", fields: [bookChartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description  String? @db.NVarChar(MAX)
  reference    String? @db.NVarChar(255)
  paymentMode  String? @db.NVarChar(255)   // Cash (at counter) | Cheque | Online Transfer
  totalAmount  Float    @default(0)
  status       String @db.NVarChar(255)   @default("Posted")  // Posted | Reversed
  reversedById String? @db.NVarChar(50)
  reversedAt   DateTime?
  reversalReason String? @db.NVarChar(255)
  postedById   String? @db.NVarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      BookVoucherLine[] @relation("BankbookLines")
  cheques    Cheque[]

  @@index([voucherType])
  @@index([voucherDate])
  @@index([branchId])
}

model JournalVoucher {
  id           String @db.NVarChar(50)   @id   // voucher number, e.g. JV/MAIN/Sep25/000001
  voucherType  String @db.NVarChar(255)   @default("JV")
  voucherDate  DateTime
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation("JournalBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description  String? @db.NVarChar(MAX)
  reference    String? @db.NVarChar(255)
  totalDebit   Float    @default(0)
  totalCredit  Float    @default(0)
  status       String @db.NVarChar(255)   @default("Posted")  // Posted | Reversed
  reversedById String? @db.NVarChar(50)
  reversedAt   DateTime?
  reversalReason String? @db.NVarChar(255)
  postedById   String? @db.NVarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      BookVoucherLine[] @relation("JournalLines")

  @@index([voucherDate])
  @@index([branchId])
}

model OpenTbVoucher {
  id           String @db.NVarChar(50)   @id   // voucher number, e.g. OTV/MAIN/Sep25/000001
  voucherType  String @db.NVarChar(255)   @default("OTV")
  voucherDate  DateTime
  branchId     String @db.NVarChar(50)
  branch       Branch   @relation("OpenTbBranch", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description  String? @db.NVarChar(255)   // short description (<= 20 chars per spec)
  reference    String? @db.NVarChar(255)
  totalDebit   Float    @default(0)
  totalCredit  Float    @default(0)
  difference   Float    @default(0)        // totalDebit - totalCredit (allowed non-zero)
  isBalanced   Boolean  @default(false)
  status       String @db.NVarChar(255)   @default("Posted")  // Posted | Reversed
  reversedById String? @db.NVarChar(50)
  reversedAt   DateTime?
  reversalReason String? @db.NVarChar(255)
  postedById   String? @db.NVarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines      BookVoucherLine[] @relation("OpenTbLines")
  knockOffs  KnockOff[]

  @@index([voucherDate])
  @@index([branchId])
}

// Shared line table for all four book voucher tables (integrity enforced in app layer)
model BookVoucherLine {
  id          String @db.NVarChar(50) @id @default(cuid())
  voucherId   String @db.NVarChar(50)      // = book voucher id (voucher number)
  voucherType String @db.NVarChar(255)     // CRV | CPV | BRV | BPV | JV | OTV
  bookType    String @db.NVarChar(255)     // CASHBOOK | BANKBOOK | JV | OTB
  accountId   String @db.NVarChar(50)
  account     Chart    @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lineDescription String? @db.NVarChar(255)
  title       String? @db.NVarChar(255)
  reference   String? @db.NVarChar(255)
  amount      Float    @default(0)
  debit       Float    @default(0)
  credit      Float    @default(0)
  billType    String?  @db.NVarChar(255)  // Sales Bill, Purchase Bill, ... (Dr/Cr side auto-applied)
  taxAccountId String? @db.NVarChar(50)
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  chequeNo    String? @db.NVarChar(255)
  chequeAmount Float?                 // kept in sync with amount (readonly)
  chequeBankName String? @db.NVarChar(255)
  chequeStatus String? @db.NVarChar(255)
  status      String @db.NVarChar(255)   @default("Active")
  createdAt   DateTime @default(now())

  cashbookVoucher CashbookVoucher? @relation("CashbookLines", map: "BKVL_cashbook_fkey", fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bankbookVoucher BankbookVoucher? @relation("BankbookLines", map: "BKVL_bankbook_fkey", fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  journalVoucher  JournalVoucher?  @relation("JournalLines",  map: "BKVL_journal_fkey", fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  openTbVoucher   OpenTbVoucher?   @relation("OpenTbLines",   map: "BKVL_opentb_fkey", fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([voucherId])
  @@index([accountId])
  @@index([bookType])
}

// Knock-off entries for unbalanced Opening Trial Balance vouchers
model KnockOff {
  id          String @db.NVarChar(50) @id @default(cuid())
  billId      String @db.NVarChar(50)   // auto: OTB-{branchCode}/{0000001}
  openTbVoucherId String @db.NVarChar(50)
  openTbVoucher OpenTbVoucher @relation(fields: [openTbVoucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountId   String @db.NVarChar(50)
  account     Chart @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String @db.NVarChar(255)   // max 20 characters
  amount      Float
  side        String @db.NVarChar(10)    // Debit | Credit
  knockedOffAt DateTime @default(now())
  createdById String? @db.NVarChar(50)
  createdAt   DateTime @default(now())

  @@index([openTbVoucherId])
}

// Atomic sequence counter for business ID generation, key like "CRV/MAIN/Sep25"
model IdSequence {
  key      String @db.NVarChar(191) @id
  next     Int    @default(1)
  updatedAt DateTime @updatedAt
}

model FinancialYear {
  id        String @db.NVarChar(50)   @id @default(cuid())
  name      String @db.NVarChar(191)   @unique
  startDate DateTime
  endDate   DateTime
  isActive Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods AccountingPeriod[]
}

model AccountingPeriod {
  id               String @db.NVarChar(50)   @id @default(cuid())
  financialYearId  String @db.NVarChar(50)
  financialYear    FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name             String @db.NVarChar(255)
  startDate        DateTime
  endDate          DateTime
  status           String @db.NVarChar(255)   @default("Open")
  createdAt        DateTime @default(now())

  @@index([financialYearId])
}

model TaxHead {
  id         String @db.NVarChar(50)   @id @default(cuid())
  code       String @db.NVarChar(255)
  shortName  String @db.NVarChar(255)
  name       String @db.NVarChar(255)
  taxType    String @db.NVarChar(255)
  rate       Float
  branchId   String? @db.NVarChar(50)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([code])
}

model Cheque {
  id         String @db.NVarChar(50)   @id @default(cuid())
  voucherId  String @db.NVarChar(50)          // = BankbookVoucher id (BRV/BPV voucher number)
  voucher    BankbookVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chequeNo   String @db.NVarChar(255)
  chequeDate DateTime
  bankName   String? @db.NVarChar(255)
  amount     Float
  status     String @db.NVarChar(255)   @default("Hold")
  statusChangedAt DateTime?
  statusChangedBy String? @db.NVarChar(255)
  statusHistory String? @db.NVarChar(255)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([chequeNo])
}

model AccountMapping {
  id          String @db.NVarChar(50)   @id @default(cuid())
  branchId    String? @db.NVarChar(50)
  key         String @db.NVarChar(255)
  accountId   String @db.NVarChar(50)
  account     Chart  @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String? @db.NVarChar(MAX)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([branchId, key])
  @@index([key])
}

model FinanceDefaults {
  id              String @db.NVarChar(50)   @id @default(cuid())
  branchId        String? @db.NVarChar(50)  @unique
  defaultCashAccountId String? @db.NVarChar(50)
  defaultBankAccountId String? @db.NVarChar(50)
  defaultTaxHeadId String? @db.NVarChar(50)
  financialYearId String? @db.NVarChar(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserReportFormat {
  id        String @db.NVarChar(50)   @id @default(cuid())
  userId    String @db.NVarChar(50)
  reportKey String @db.NVarChar(255)
  name      String @db.NVarChar(255)
  columns   String @db.NVarChar(255)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportKey, name])
  @@index([userId, reportKey])
}

// =================================================================
// GYM
// =================================================================

model Member {
  id              String @db.NVarChar(50)   @id @default(cuid())
  memberId        String @db.NVarChar(50)   @unique
  firstName       String @db.NVarChar(255)
  lastName        String? @db.NVarChar(255)
  gender          String? @db.NVarChar(255)
  dob             DateTime?
  phone           String? @db.NVarChar(255)
  whatsapp        String? @db.NVarChar(255)
  email           String? @db.NVarChar(255)
  address         String? @db.NVarChar(MAX)
  emergencyContact String? @db.NVarChar(255)
  emergencyContactNo String? @db.NVarChar(255)
  photo           String? @db.NVarChar(255)
  cnic            String? @db.NVarChar(255)
  joiningDate     DateTime @default(now())
  billingStartDate DateTime?
  feeRelaxationDays Int @default(0)
  status          String @db.NVarChar(255)   @default("Active")
  membershipPlanId String? @db.NVarChar(50)
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId        String @db.NVarChar(50)
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTrainerId String? @db.NVarChar(50)
  notes           String? @db.NVarChar(MAX)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  attendance         Attendance[]
  fees               Fee[]
  progress           ProgressEntry[]
  freezes            MembershipFreeze[]
  followUps          FollowUp[]
  workoutAssignments WorkoutAssignment[]
  dietAssignments    DietAssignment[]
  fitnessGoals       FitnessGoal[]
  ptSessions         PersonalTrainingSession[]

  @@index([branchId])
  @@index([status])
  @@index([phone])
}

model MembershipPlan {
  id           String @db.NVarChar(50)   @id @default(cuid())
  code          String @db.NVarChar(191)   @unique
  name          String @db.NVarChar(255)
  durationDays  Int
  amount        Float
  description   String? @db.NVarChar(MAX)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      Member[]
}

model Attendance {
  id         String @db.NVarChar(50)   @id @default(cuid())
  memberId   String @db.NVarChar(50)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branchId   String @db.NVarChar(50)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String? @db.NVarChar(MAX)
  createdAt  DateTime @default(now())

  @@unique([memberId, date])
  @@index([branchId, date])
}

model Fee {
  id           String @db.NVarChar(50)   @id @default(cuid())
  feeNo        String @db.NVarChar(191)   @unique
  memberId     String @db.NVarChar(50)
